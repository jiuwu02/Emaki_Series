# Java / Gradle build output
# Gradle：根工程与各子工程的构建输出、项目级缓存（gradle/wrapper 与 *.gradle 需入库，不在此列）
/build/
/*/build/
/.gradle/
/*/.gradle/
# Maven 时代遗留目录：目录已删除，保留忽略规则以防被旧工具重新生成
/target/
/*/target/
*.class

# IDE / OS local files
*.iml
Thumbs.db

# Python local cache
__pycache__/
*.py[cod]

# Local environment / secrets
.env
.env.*
!.env.example
.key
*.key

# Local project notes / generated helper docs
*.md
.*/
docs/
tools/
release version/
screenshot_guide/
emaki_manager.py

!README_EN.md

*.html
*.png
*.py
*.json
*.svg