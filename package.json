{
  "name": "emaki-web-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "EmakiCoreLib/web-console",
    "EmakiGem/web-console",
    "EmakiForge/web-console",
    "EmakiSkills/web-console",
    "EmakiStrengthen/web-console",
    "EmakiCooking/web-console",
    "EmakiAttribute/web-console",
    "EmakiItem/web-console",
    "EmakiLevel/web-console",
    "EmakiCodex/web-console"
  ],
  "scripts": {
    "build:web": "npm run build --workspaces --if-present",
    "build:web:core": "npm run build -w emaki-web-console",
    "build:web:gem": "npm run build -w emakigem-web-console-extension",
    "build:web:forge": "npm run build -w emakiforge-web-console-extension",
    "build:web:skills": "npm run build -w emakiskills-web-console-extension",
    "build:web:strengthen": "npm run build -w emakistrengthen-web-console-extension",
    "build:web:cooking": "npm run build -w emakicooking-web-console-extension",
    "build:web:attribute": "npm run build -w emakiattribute-web-console-extension",
    "build:web:item": "npm run build -w emakiitem-web-console-extension",
    "build:web:level": "npm run build -w emakilevel-web-console-extension",
    "build:web:codex": "npm run build -w emakicodex-web-console-extension",
    "web:build-matrix": "npm run build:web"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
