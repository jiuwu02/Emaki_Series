<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>emaki.jiuwu.craft</groupId>
        <artifactId>emaki-parent</artifactId>
        <version>4.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>emaki-forge</artifactId>
    <version>4.7.4</version>
    <name>EmakiForge</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>emaki.jiuwu.craft</groupId>
            <artifactId>emaki-corelib-api</artifactId>
            <version>${emaki.corelib.version}</version>
        </dependency>
        <dependency>
            <groupId>emaki.jiuwu.craft</groupId>
            <artifactId>emaki-corelib</artifactId>
            <version>${emaki.corelib.version}</version>
        </dependency>
        <dependency>
            <groupId>emaki.jiuwu.craft</groupId>
            <artifactId>emaki-forge-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>emaki.jiuwu.craft</groupId>
            <artifactId>emaki-skills-api</artifactId>
            <version>${emaki.skills.api.version}</version>
        </dependency>
        <dependency>
            <groupId>emaki.jiuwu.craft</groupId>
            <artifactId>emaki-attribute-api</artifactId>
            <version>${emaki.attribute.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>paper-plugin.yml</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>paper-plugin.yml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>emaki.jiuwu.craft:emaki-forge-api</include>
                                    <include>emaki.jiuwu.craft:emaki-skills-api</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <!--
                                    Declared locally on purpose: plexus-utils merges child <filters> with the
                                    parent list by position, so a new parent entry after index 0 would not be
                                    applied here. See the matching comment in the root POM for why our own
                                    API jar's manifest is the actual source of the shade warning, and why the
                                    pattern must stay scoped to *-api rather than all of emaki.jiuwu.craft:*.
                                -->
                                <filter>
                                    <artifact>emaki.jiuwu.craft:*-api</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>emaki.jiuwu.craft:emaki-skills-api</artifact>
                                    <includes>
                                        <include>emaki/jiuwu/craft/skills/api/pdc/**</include>
                                    </includes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>emaki.jiuwu.craft.skills.api.pdc</pattern>
                                    <shadedPattern>emaki.jiuwu.craft.forge.runtime.skillsprotocol</shadedPattern>
                                </relocation>
                            </relocations>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
