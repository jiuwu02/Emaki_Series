    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <proc>none</proc>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <encoding>${project.build.sourceEncoding}</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <!--
                            关闭 DocLint 的 missing 组。该组覆盖「缺 @param / 缺 @return / 无注释 /
                            无主说明」四类，实测全量为 1159 条（构建日志显示的 698 条是 javadoc 默认
                            -Xmaxwarns 100 截断后的假数，4 个模块的计数都正好停在 100）。

                            公开面文档不靠本开关兜底：公开事件类、各模块 API 入口（*Catalog /
                            *Operations / *Extensions / Emaki*Api / ItemRepair / ItemMigration）以及
                            全部「无主说明」缺陷已逐条补齐 javadoc，屏蔽后这些文件复跑 -Xdoclint:all
                            仍为 0。被本开关屏蔽的 806 条集中在 record 组件 @param 与 getter /
                            紧凑构造器 / 常量的「无注释」——自解释数据载体，逐条补齐只会产出无信息
                            文档。这是有意保留的文档覆盖率债，不是「已完备」。

                            其余 DocLint 组（accessibility / html / reference / syntax）保持开启：
                            它们检查的是文档正确性（坏链接、错误标签、语法错误），必须继续失败可见。
                        -->
                        <doclint>all,-missing</doclint>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <phase>package</phase>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.2</version>
                    <configuration>
                        <createDependencyReducedPom>false</createDependencyReducedPom>
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>module-info.class</exclude>
                                    <exclude>META-INF/versions/**/module-info.class</exclude>
                                </excludes>
                            </filter>
                            <!--
                                Each runtime module shades its own API jar, and that jar carries its own
                                META-INF/MANIFEST.MF which collides with the module's manifest. That is the
                                real source of the 11 shade "overlapping resource" warnings (one per runtime
                                module) - not the dependency-specific filters below, none of which ever
                                trigger because no module shades exp4j / caffeine / kyori / jspecify /
                                auto-service / error_prone.

                                Scoped to *-api on purpose. A blanket emaki.jiuwu.craft:* pattern also matches
                                the module's own main artifact and strips the manifest shade would otherwise
                                have kept, leaving the shipped jar with no META-INF/MANIFEST.MF at all.
                            -->
                            <filter>
                                <artifact>emaki.jiuwu.craft:*-api</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                    <exclude>META-INF/maven/**</exclude>
                                </excludes>
                            </filter>
                            <filter>
                                <artifact>net.objecthunter:exp4j</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                    <exclude>META-INF/maven/**</exclude>
                                </excludes>
                            </filter>
                            <filter>
                                <artifact>com.google.errorprone:error_prone_annotations</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                    <exclude>META-INF/maven/**</exclude>
                                </excludes>
                            </filter>
                            <filter>
                                <artifact>net.kyori:*</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                </excludes>
                            </filter>
                            <filter>
                                <artifact>com.google.auto.service:auto-service-annotations</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                    <exclude>META-INF/maven/**</exclude>
                                </excludes>
                            </filter>
                            <filter>
                                <artifact>org.jspecify:jspecify</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                </excludes>
                            </filter>
                            <filter>
                                <artifact>com.github.ben-manes.caffeine:caffeine</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                    <exclude>META-INF/maven/**</exclude>
                                </excludes>
                            </filter>
                            <!--
                                bstats-base and bstats-bukkit are shaded together and both carry their own
                                manifest, so they overlap with each other rather than with our artifacts.
                                This is the one MANIFEST collision the emaki.jiuwu.craft:* filter above does
                                not cover.
                            -->
                            <filter>
                                <artifact>org.bstats:*</artifact>
                                <excludes>
                                    <exclude>META-INF/MANIFEST.MF</exclude>
                                    <exclude>META-INF/maven/**</exclude>
                                </excludes>
                            </filter>
                            <filter>
                                <artifact>org.bstats:bstats-bukkit</artifact>
                                <excludes>
                                    <exclude>plugin.yml</exclude>
                                </excludes>
                            </filter>
                        </filters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
